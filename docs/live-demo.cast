[0.000, "o", "\r\n\u001b[1m── v0.4.0 headline features ──\u001b[0m\r\n\r\n"]
[0.017, "o", "\u001b[0;36mMCP policing\u001b[0m  deny an un-allowlisted MCP tool by name (deny.tools)\r\n"]
[0.011, "o", "     \u001b[0;33mcall:\u001b[0m mcp__exfil__send   \u001b[0;32mBLOCKED\u001b[0m  MCP tool not on the allowlist\r\n\r\n\u001b[0;36mmulti-agent + exit 2\u001b[0m  same block via the generic adapter; exit 2 is the second enforcement channel\r\n"]
[0.006, "o", "{\"decision\":\"block\",\"reason\":\"MCP tool not on the allowlist\"}\r\n"]
[0.001, "o", "     \u001b[0;32mexit: 2\u001b[0m\r\n\r\n"]
